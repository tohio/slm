# ── AWS / S3 ──────────────────────────────────────────────────────────────────
S3_BUCKET=...                      # your S3 bucket name
S3_PREFIX=slm/data                  # key prefix inside the bucket
AWS_ACCESS_KEY_ID=...               # IAM user credentials
AWS_SECRET_ACCESS_KEY=...           # IAM user credentials
AWS_DEFAULT_REGION=us-east-1        # S3 client region
# ── Data ──────────────────────────────────────────────────────────────────────
DATA_DIR=/data/slm/data             # set automatically by setup-curate/setup-train
RESULTS_DIR=/data/slm/results       # target-scoped checkpoints
EXPORTS_DIR=/data/slm/exports       # native model packages
# ── HuggingFace cache ─────────────────────────────────────────────────────────
HF_HOME=/data/slm/hf_cache          # set automatically by setup-curate/setup-train
HF_DATASETS_CACHE=/data/slm/hf_cache # set automatically by setup-curate/setup-train
HF_XET_HIGH_PERFORMANCE=1
# ── Experiment tracking ───────────────────────────────────────────────────────
WANDB_API_KEY=...                   # from wandb.ai/settings
WANDB_PROJECT=slm                   # W&B project name
# ── HuggingFace Hub ───────────────────────────────────────────────────────────
# HF_TOKEN is used for Dataset/Model repo pushes and gated dataset access.
# Bucket object transfers use separate HF-generated S3 keys below.
# Required at curation time for: bigcode/the-stack-dedup,
# bigcode/the-stack-smol, and nvidia/Nemotron-CC-Math-v1.
# Accept each dataset's terms with this Hugging Face account first.
HF_TOKEN=...                        # from huggingface.co/settings/tokens
HF_USERNAME=...                     # your HF username
EXPORTS_DIR=/data/slm/exports

# ── Optional HF artifact destinations (ARTIFACT_BACKEND=hf) ───────────────────
# Dataset stages: curated/validated. Other artifact stages: Storage Bucket.
HF_DATASET_REPO=                   # namespace/dataset-name
HF_ARTIFACT_BUCKET=                # namespace/bucket-name (create in HF first)
HF_ARTIFACT_PREFIX=slm/data
HF_S3_ACCESS_KEY_ID=               # HF-generated S3 credential, NOT an AWS key
HF_S3_SECRET_ACCESS_KEY=

# ── Optional read-only chat search (--web-search) ─────────────────────────────
WEB_SEARCH_PROVIDER=              # brave or searxng; disabled unless CLI flag set
BRAVE_SEARCH_API_KEY=              # only for the Brave adapter
SEARXNG_URL=                       # HTTPS JSON-enabled /search endpoint
