# ── AWS / S3 ──────────────────────────────────────────────────────────────────
S3_BUCKET=         # your S3 bucket name
S3_PREFIX=slm/data                  # key prefix inside the bucket
AWS_ACCESS_KEY_ID=...               # IAM user credentials
AWS_SECRET_ACCESS_KEY=...           # IAM user credentials
AWS_DEFAULT_REGION=us-east-1        # must be us-east-1 for Common Crawl
# ── Data ──────────────────────────────────────────────────────────────────────
DATA_DIR=/data/slm/data             # set automatically by setup.sh
RESULTS_DIR=results                 # root where target-scoped checkpoints are saved
# ── HuggingFace cache ─────────────────────────────────────────────────────────
HF_HOME=/data/slm/hf_cache          # set automatically by setup.sh
HF_DATASETS_CACHE=/data/slm/hf_cache # set automatically by setup.sh
HF_XET_HIGH_PERFORMANCE=1
# ── Experiment tracking ───────────────────────────────────────────────────────
WANDB_API_KEY=...                   # from wandb.ai/settings
WANDB_PROJECT=slm                   # W&B project name
# ── HuggingFace Hub ───────────────────────────────────────────────────────────
# HF_TOKEN is used for both model pushes and gated dataset access.
# Required at curation time for: HuggingFaceFW/fineweb, bigcode/the-stack-smol,
# bigcode/the-stack-v2-dedup. Accept Terms of Use on each dataset page first.
HF_TOKEN=...                        # from huggingface.co/settings/tokens
HF_USERNAME=                        # your HF username
# ── Software Heritage Archive ─────────────────────────────────────────────────
# Optional but strongly recommended. the-stack-v2-dedup stores file metadata
# on HuggingFace and fetches actual source code from the Software Heritage
# Archive per-record at curation time. Unauthenticated requests are heavily
# rate-limited; at 1b scale this can multiply stack-v2 fetch time by 10×+.
# Register at https://archive.softwareheritage.org/ to obtain a token.
SWH_AUTH_TOKEN=                     # optional — leave empty to use unauthenticated fetches
# ── Groq synthetic data generation ────────────────────────────────────────────
# Required when curation runs Groq-backed synthetic sources:
#   synthetic_task_code
#   educational_qa_mcq
#   factual_restraint
#   synthetic_arithmetic
#
# These sources call Groq during Stage 1 and write raw JSONL directly under:
#   data/runs/<size>/raw/<source>/
#
# Existing raw shards are skipped. To regenerate, delete the target-scoped
# raw/filtered/dedup directories for that source before rerunning curation.
#
# Groq usage can incur API cost. Cost depends on model, input/output tokens,
# batch size, and target size.
GROQ_API_KEY=                       # from console.groq.com

# Default Groq model for all synthetic sources unless overridden below.
SYNTHETIC_GROQ_MODEL=llama-3.1-8b-instant
SYNTHETIC_GROQ_TEMPERATURE=0.8
SYNTHETIC_GROQ_MAX_TOKENS=4096

GROQ_MIN_REQUEST_INTERVAL_SECONDS=0.5
GROQ_MAX_RETRIES=6
GROQ_RETRY_BASE_SECONDS=2
GROQ_RETRY_MAX_SECONDS=60

# Optional stronger per-source Groq model overrides.
# Recommended:
#   synthetic_task_code      -> stronger model
#   educational_qa_mcq       -> stronger model
#   factual_restraint        -> stronger model if quality needs it
#   synthetic_arithmetic     -> default model is usually enough
GROQ_MODEL_SYNTHETIC_TASK_CODE=qwen/qwen3-32b
GROQ_MODEL_EDUCATIONAL_QA_MCQ=qwen/qwen3-32b
GROQ_MODEL_FACTUAL_RESTRAINT=qwen/qwen3-32b
GROQ_MODEL_SYNTHETIC_ARITHMETIC=